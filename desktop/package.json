{
  "name": "veyra-desktop",
  "version": "0.28.14",
  "private": true,
  "description": "Veyra 桌面端：本地解析、下载、合并，账号与片单与手机端同步",
  "main": "dist/main/index.cjs",
  "author": "gybeyond1",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "dist:win": "node scripts/fetch-mpv.mjs && npm run build && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "fetch:mpv": "node scripts/fetch-mpv.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "ffmpeg-static": "^5.2.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "hls.js": "^1.7.4"
  }
}